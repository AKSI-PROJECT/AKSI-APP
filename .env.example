# Salin file ini menjadi .env dan isi nilainya.
# .env tidak ikut di-commit (lihat .gitignore).

# Supabase (URL proyek + anon key dari Dashboard > Settings > API)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Google Safe Browsing API v4
# https://developers.google.com/safe-browsing/v4
# Tanpa key, hasil pemindaian hanya berbasis heuristik lokal
# dan status "Tidak Dapat Diverifikasi" (fail-closed).
SAFE_BROWSING_API_KEY=
